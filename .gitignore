.pytest_cache/
.coverage
htmlcov/
*.db
*.sqlite3

# Alembic migration files (alembic/versions/*.py) are DELIBERATELY tracked
# — they are the schema's actual history, not build output. A previous rule
# here (`alembic/versions/`) would have silently excluded every migration
# ever written; caught before the first one was committed (DECISIONS.md,
# 2026-09-19). Only Alembic's own __pycache__ needs ignoring, already
# covered by the top-level __pycache__/ rule below.

# Node
node_modules/
dist/
.cache/
.parcel-cache/
*.local

# Uploads (temp files) — both the repo-root and backend/ runtime locations
# (an unanchored dir pattern matches at any depth; 'uploads/*' only matched root)
uploads/
test_output.xlsx

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
logs/

# Real attestation sheets — student PII, never commit
*.pdf
!frontend/**/*.pdf
