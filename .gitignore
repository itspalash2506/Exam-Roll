# Secrets
.env
.gitignore

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
ENV/
env/
pip-log.txt
pip-delete-this-directory.txt
