# ── ExamRoll backend environment ─────────────────────────────────────────────
# Copy to .env for local dev. In production (Render), set these in the
# dashboard's Environment tab — NEVER commit real values.

# Groq API key (required for AI classification; app falls back to rule-based
# extraction without it). Get one at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Local dev: SQLite, resolves relative to backend/ (where uvicorn runs).
# If the host's app dir is read-only, use an absolute /tmp path instead:
#   DATABASE_URL=sqlite+aiosqlite:////tmp/examroll/examroll.db
#
# Production: Postgres (Supabase) — swap the driver, everything else about
# the app is unchanged (DECISIONS.md, 2026-09-19):
#   DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/<db>
#
# Schema is applied by Alembic, not at app boot — run this once per
# environment before starting the app (from backend/):
#   alembic upgrade head
# alembic/env.py derives its own sync connection from this same URL, so
# there is exactly one place the DB location is configured.
DATABASE_URL=sqlite+aiosqlite:///./examroll.db

# Upload/output directory — created automatically on startup if missing.
# On a read-only host dir, use e.g. UPLOAD_DIR=/tmp/examroll/uploads
#
# Only the FALLBACK storage location now (DECISIONS.md, 2026-09-20): used
# only when the four R2_* variables below are unset. Uploaded source files
# and generated Excel outputs live in Cloudflare R2 whenever R2 is
# configured, not here — this stops local disk from accumulating files at
# all in production. A brief local touch still happens during upload
# itself (chunked async I/O can't hand bytes directly to the sync R2
# client), but that copy is deleted immediately after the push to R2.
UPLOAD_DIR=./uploads

# Object storage — Cloudflare R2 (DECISIONS.md, 2026-09-20). All four
# required together for R2 to be used; leave all empty to keep using local
# disk (UPLOAD_DIR above) instead — the default, so local dev needs no R2
# account. Get these from the Cloudflare dashboard: R2 → your bucket →
# Manage API Tokens → Create API Token (Object Read & Write).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

MAX_FILE_SIZE_MB=50

# Allowed browser origins, comma-separated (JSON array form also accepted).
# Local dev:   http://localhost:5173
# Production:  add the deployed frontend origin, e.g.
#   CORS_ORIGINS=http://localhost:5173,https://exam-roll.pages.dev
CORS_ORIGINS=http://localhost:5173

# Optional regex for origins that can't be listed ahead of time — mainly
# Cloudflare Pages PREVIEW builds, which get a new per-build subdomain
# (https://<hash>.exam-roll.pages.dev). Leave empty to disable (exact list only).
# SECURITY: anchor it (^...$) and pin your own domain — allow_credentials is on,
# so a loose pattern would let any *.pages.dev site call this API.
#   CORS_ORIGIN_REGEX=^https://([a-z0-9-]+\.)?exam-roll\.pages\.dev$
CORS_ORIGIN_REGEX=

APP_ENV=development
LOG_LEVEL=INFO

# SQL echo — logs every SQL statement to the console. Useful for debugging.
# MUST remain false in production: it logs student PII (roll numbers, names)
# to the application log stream. The app refuses to start if SQL_ECHO=true
# and APP_ENV=production.
SQL_ECHO=false

# Pilot notice — displayed as a banner on the Dashboard. Set to the centre
# name for the pilot (e.g. "Pilot instance — SRIT Exam Centre"). Leave empty
# or unset to hide the banner.
VITE_PILOT_NOTICE=
